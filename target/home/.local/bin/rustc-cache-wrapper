#!/usr/bin/env bash
# Use sccache when available, but never block Cargo during first-run tool setup.

set -Eeuo pipefail

if command -v sccache >/dev/null 2>&1; then
  exec sccache "$@"
fi

mise_bin="${MISE_INSTALL_PATH:-${HOME}/.local/bin/mise}"
if [[ -x "${mise_bin}" ]]; then
  sccache_bin="$("${mise_bin}" which sccache 2>/dev/null || true)"
  if [[ -x "${sccache_bin}" ]]; then
    exec "${sccache_bin}" "$@"
  fi
fi

exec "$@"
