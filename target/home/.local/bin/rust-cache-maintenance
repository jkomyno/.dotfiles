#!/usr/bin/env bash
# Rust build storage safety net for Mr Boxington (mbx).
#
# mbx already collects managed target directories after builds (checkout gone,
# 30-day age, disk budget, low-disk pressure), so this LaunchAgent-triggered run
# is only a periodic `mbx gc` for abandoned checkouts between builds. It replaces
# the retired sccache wrapper + cargo-clean-all scheme.

set -Eeuo pipefail

MISE_BIN="${MISE_INSTALL_PATH:-${HOME}/.local/bin/mise}"

log() { printf '==> %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

run_gc() {
  if command -v mbx >/dev/null 2>&1; then
    mbx gc "$@"
  elif [[ -x "${MISE_BIN}" ]]; then
    "${MISE_BIN}" x mr-boxington -- mbx gc "$@"
  else
    die "mbx is unavailable; install the managed mise tool"
  fi
}

mode="preview"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) mode="check" ;;
    --dry-run) mode="preview" ;;
    --apply) mode="apply" ;;
    --scheduled) mode="apply" ;;
    -h | --help)
      sed -n '2,4p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      printf '\nUsage: rust-cache-maintenance [--check|--dry-run|--apply|--scheduled]\n'
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

case "${mode}" in
  check)
    command -v mbx >/dev/null 2>&1 && log "mbx available" || die "mbx missing"
    ;;
  preview)
    run_gc --dry-run
    ;;
  apply)
    run_gc
    ;;
esac
