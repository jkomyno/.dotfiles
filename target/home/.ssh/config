# Managed by this dotfiles repository. Machine-specific hosts belong in ~/.ssh/config.local,
# which is intentionally unmanaged; a missing Include target is fine.
Include ~/.orbstack/ssh/config
Include ~/.ssh/config.local

# Reach GitHub over port 443 (the HTTPS port) instead of 22. Corporate
# firewalls and public wifi often block port 22; 443 is never blocked, so
# git-over-SSH works from anywhere. ssh.github.com is GitHub's SSH endpoint
# listening on 443.
Host github.com
  HostName ssh.github.com
  Port 443
  # Pin git-over-SSH to the default agent so the Secretive block below never
  # shadows the GitHub key. This is the standard behaviour, so it is a no-op
  # until Secretive is in play; because it appears before that block, ssh's
  # first-value-wins rule keeps GitHub on the default agent. (A Match-host
  # exclusion cannot do this: Match compares the post-HostName name,
  # ssh.github.com, not github.com.)
  IdentityAgent SSH_AUTH_SOCK

# TouchID-backed SSH keys via Secretive (Secure Enclave). The private key never
# leaves the Secure Enclave and every use requires TouchID. This block only
# takes effect when Secretive's agent socket exists (`Match exec` guard), so a
# fresh machine that has not set Secretive up yet keeps using its normal keys
# and SSH still works out of the box. To *force* a specific remote to use only
# the TouchID key, add `IdentitiesOnly yes` to that host in ~/.ssh/config.local.
# Setup: docs/touchid-ssh.md.
Match exec "test -S ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
