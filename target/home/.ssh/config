# Managed by this dotfiles repository. Machine-specific hosts belong in ~/.ssh/config.local,
# which is intentionally unmanaged; a missing Include target is fine.
Include ~/.orbstack/ssh/config
Include ~/.ssh/config.local

# Reach GitHub over port 443 (the HTTPS port) instead of 22. Corporate
# firewalls and public wifi often block port 22; 443 is never blocked, so
# git-over-SSH works from anywhere. ssh.github.com is GitHub's SSH endpoint
# listening on 443.
Host github.com
  HostName ssh.github.com
  Port 443

# TouchID-backed SSH via Secretive (Secure Enclave) is wired per host in
# ~/.ssh/config.local, not here: only hosts whose authorized_keys hold your
# Secure Enclave public key should route through Secretive's agent, and which
# hosts those are is machine-specific. A global IdentityAgent would hijack every
# host — including ones that authenticate from the default agent — and break
# them. Setup: docs/touchid-ssh.md.

# Keep idle connections alive so NATs, firewalls, and VPNs don't silently drop
# them (the "client_loop: send disconnect: Broken pipe" you'd otherwise hit on
# resume). ServerAliveInterval sends an encrypted keepalive through the SSH
# channel every 60s of inactivity — this is what keeps middleboxes' state tables
# warm. After ServerAliveCountMax unanswered probes (~3 min) a genuinely dead
# link disconnects cleanly instead of hanging. Wildcard goes last: SSH is
# first-match-wins per parameter, so any host in config.local (included above)
# can override these.
Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  TCPKeepAlive yes
