{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Agent(compound-engineering:*)",
      "Bash(* --help *)",
      "Bash(* --version)",
      "Bash(.venv*)",
      "Bash(awk *)",
      "Bash(awk)",
      "Bash(basename *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(cut *)",
      "Bash(dirname *)",
      "Bash(docker *)",
      "Bash(echo *)",
      "Bash(env *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh repo clone *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run view *)",
      "Bash(gh workflow *)",
      "Bash(git *)",
      "Bash(git commit *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(lsof *)",
      "Bash(make *)",
      "Bash(mkdir *)",
      "Bash(node *)",
      "Bash(nox *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(pytest *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(realpath *)",
      "Bash(rm *)",
      "Bash(ruff *)",
      "Bash(sed *)",
      "Bash(sed)",
      "Bash(sort *)",
      "Bash(source *)",
      "Bash(timeout *)",
      "Bash(tree *)",
      "Bash(tsc *)",
      "Bash(tsx *)",
      "Bash(uniq *)",
      "Bash(unset *)",
      "Bash(uv *)",
      "Bash(vhs:*)",
      "Bash(wc *)",
      "Bash(xargs *)",
      "Bash(yarn *)",
      "Bash(yq *)",
      "Edit(**)",
      "Grep(**)",
      "LS(**)",
      "Read(**)",
      "Skill(compound-engineering:*)",
      "WebFetch",
      "WebSearch",
      "mcp__ide__getDiagnostics",
      "mcp__linear-server__get_*",
      "mcp__plugin_compound-engineering_context7__query-docs",
      "mcp__plugin_compound-engineering_context7__resolve-library-id"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-claude-attribution.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-rm.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/jkomyno/.claude/skills/impeccable/scripts/impeccable' ] || '/Users/jkomyno/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/jkomyno/.claude/skills/impeccable/scripts/impeccable' ] || '/Users/jkomyno/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/jkomyno/.claude/skills/impeccable/scripts/impeccable' ] || '/Users/jkomyno/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/share/mise/shims/ccstatusline"
  },
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true,
    "frontend-design@claude-plugins-official": true,
    "interface-design@interface-design": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "composio@composio": true
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
