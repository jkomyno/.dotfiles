<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed by dotfiles: target/home/Library/LaunchAgents/sh.paseo.daemon.plist

  Keeps the paseo daemon (https://paseo.sh) running in the login session so the
  paseo phone/web app can drive local coding agents on this Mac at any time.

  Rendered by `mise bootstrap dotfiles apply` (template mode) with the real $HOME baked in.
  paseo is a mise tool (npm:@getpaseo/cli). It is launched via `mise exec` with an
  explicit backend rather than a shim, because a shim is not always generated
  (e.g. on activate-mode machines) whereas `mise exec npm:@getpaseo/cli` always
  resolves. The daemon run command keeps the supervisor in the foreground.
  Paseo binds loopback by default; use SSH forwarding for remote access.
  Load/manage/pair it with `just paseo`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sh.paseo.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ env.HOME }}/.local/bin/mise</string>
    <string>exec</string>
    <string>node</string>
    <string>npm:@getpaseo/cli</string>
    <string>--</string>
    <string>paseo</string>
    <string>daemon</string>
    <string>run</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ env.HOME }}</string>
    <key>PASEO_LISTEN</key>
    <string>127.0.0.1:6767</string>
    <key>PASEO_HOSTNAMES</key>
    <string>true</string>
    <key>MISE_EXEC_AUTO_INSTALL</key>
    <string>0</string>
    <key>PATH</key>
    <string>{{ env.HOME }}/.local/share/mise/shims:{{ env.HOME }}/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>{{ env.HOME }}</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>{{ env.HOME }}/Library/Logs/paseo.daemon.log</string>

  <key>StandardErrorPath</key>
  <string>{{ env.HOME }}/Library/Logs/paseo.daemon.err.log</string>
</dict>
</plist>
