{
  "theme": "system",
  "systemThemeAutoReload": true,
  "showScrollbars": false,
  "editorCommand": "cd {{repoPath}} && gh pr checkout {{number}} && nvim -c \"DiffviewOpen {{baseRef}}...{{headRef}}\"",
  "repoPaths": {
    "jkomyno/:repo": "~/work/me/:repo",
    "ComposioHQ/:repo": "~/work/composio/:repo",
    ":owner/:repo": "~/work/:owner/:repo"
  }
}
