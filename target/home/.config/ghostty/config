# Ghostty configuration managed by the dotfiles repo.
# Managed by this dotfiles repository through mise dotfiles.
# Reference: https://ghostty.org/docs/config/reference

theme = Catppuccin Macchiato
font-family = "Hack Nerd Font Mono"
font-size = 16
shell-integration = zsh
macos-titlebar-style = tabs
confirm-close-surface = false
window-save-state = always

# mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# keybinds
keybind = cmd+s>r=reload_config
keybind = cmd+s>x=close_surface

# tabs
keybind = cmd+t=new_tab
keybind = cmd+j=previous_tab
keybind = cmd+k=next_tab

# splits
keybind = cmd+s>j=goto_split:bottom
keybind = cmd+s>k=goto_split:top
keybind = cmd+s>h=goto_split:left
keybind = cmd+s>l=goto_split:right
keybind = shift+enter=text:\n

# scrollback (performable: the key passes through to the app when scrolling
# is impossible, e.g. inside alternate-screen TUIs)
keybind = performable:shift+up=scroll_page_lines:-3
keybind = performable:shift+down=scroll_page_lines:3
keybind = performable:cmd+shift+u=scroll_page_fractional:-0.5
keybind = performable:cmd+shift+d=scroll_page_fractional:0.5
