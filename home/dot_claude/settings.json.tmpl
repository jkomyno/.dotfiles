      "mcp__plugin_compound-engineering_context7__resolve-library-id"
    ],
    "ask": [
      "Bash(rm -rf *)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/.better-coding-agents/resources/effect/code"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/lattice/lattice-event-hook.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/lattice/lattice-event-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/lattice/lattice-event-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/lattice/lattice-event-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-claude-attribution.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/ccstatusline"
  },
  "enabledPlugins": {
    "compound-engineering@every-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "interface-design@interface-design": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "fastMode": true,
  "skipDangerousModePermissionPrompt": true
}
