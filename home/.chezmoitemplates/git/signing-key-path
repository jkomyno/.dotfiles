{{- /*
Resolves the SSH public key used for Composio commit signing, or renders
nothing when no supported key exists. Re-evaluated on every apply so a key
generated after the first bootstrap is picked up without re-running
`chezmoi init`. Precedence: GIT_SSH_SIGNING_KEY, then default key paths.
*/ -}}
{{- $signingKeyPath := "" -}}
{{- $candidateSigningKeyPaths := list (env "GIT_SSH_SIGNING_KEY") (joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub") (joinPath .chezmoi.homeDir ".ssh/id_rsa.pub") -}}
{{- range $candidateSigningKeyPaths -}}
{{-   if not $signingKeyPath -}}
{{-     $candidateSigningKeyPath := . -}}
{{-     if and $candidateSigningKeyPath (not (hasSuffix ".pub" $candidateSigningKeyPath)) -}}
{{-       $candidateSigningKeyPath = printf "%s.pub" $candidateSigningKeyPath -}}
{{-     end -}}
{{-     if and $candidateSigningKeyPath (stat $candidateSigningKeyPath) -}}
{{-       $signingKeyPath = $candidateSigningKeyPath -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $signingKeyPath -}}
