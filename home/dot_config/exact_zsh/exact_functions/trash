# Move files to the macOS Trash instead of permanently deleting them.
# Autoloaded: this file is the function body.
if (( $# < 1 )); then
  echo "Usage: trash <file>..." >&2
  return 1
fi
local file dest
for file in "$@"; do
  if [[ ! -e "$file" ]]; then
    echo "trash: '$file' does not exist" >&2
    continue
  fi
  dest="$HOME/.Trash/${file:t}"
  [[ -e "$dest" ]] && dest="$dest.$(date +%s)"
  mv -v "$file" "$dest"
done
