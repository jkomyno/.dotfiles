{{- $signingKeyPath := includeTemplate "git/signing-key-path" . | trim -}}
{{- if $signingKeyPath -}}
# Generated by chezmoi from local SSH public key state.

[user]
	signingKey = {{ $signingKeyPath }}

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgSign = true
{{- end }}
