{{- $platform := "macos" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $platform = "linux" -}}
{{- end -}}
{{- $checkoutDir := env "DOTFILES_CHECKOUT_DIR" -}}
{{- if eq $checkoutDir "" -}}
{{-   $workDir := env "DOTFILES_WORK_DIR" -}}
{{-   if eq $workDir "" -}}
{{-     $workDir = joinPath .chezmoi.homeDir "work" "me" -}}
{{-   end -}}
{{-   $checkoutDir = joinPath $workDir "dotfiles" -}}
{{- end -}}
# macOS arm64 is the active target.
# Linux is intentionally one future profile.
sourceDir: {{ joinPath $checkoutDir "home" | quote }}
data:
  platform: {{ $platform | quote }}
  os: {{ .chezmoi.os | quote }}
  arch: {{ .chezmoi.arch | quote }}
